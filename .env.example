# Copy to .env.local for local development.
#
# Preferred: provision via Vercel Marketplace (Neon) so this is filled in for you:
#   npm i -g vercel
#   vercel link
#   vercel integration add neon
#   vercel env pull .env.local --yes
#
# Fallback: paste a connection string from any Postgres provider (Neon, Supabase, local).
DATABASE_URL="postgresql://user:password@host:5432/mathflow?sslmode=require"
